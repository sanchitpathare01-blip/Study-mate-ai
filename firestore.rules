rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write only their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Future Phase 2 and 3 rules (Summaries, Quizzes, Flashcards) will be scoped under user ownership
  }
}
